#!/usr/bin/env bash
# Launcher for the wiki-interest-research CLI.
# First run creates an isolated virtualenv from pinned requirements (needs python3 >= 3.11); later runs
# start instantly and re-install when requirements.txt changes. If PyPI is not reachable (sandboxed
# environments such as the Claude.ai chat), it falls back to already-installed numpy/matplotlib/reportlab.
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${WPV_VENV:-$SKILL_DIR/.venv}"
REQ="$SKILL_DIR/scripts/requirements.txt"
PY="${WPV_PYTHON:-python3}"
RUN_PY="$VENV/bin/python"

has_deps() { "$1" -c 'import numpy, matplotlib, reportlab' 2>/dev/null; }

if [ -f "$VENV/.system-fallback" ] && has_deps "$PY"; then
  RUN_PY="$PY"
elif [ ! -x "$VENV/bin/python" ] || ! cmp -s "$REQ" "$VENV/.requirements.installed"; then
  if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    echo '{"status": "error", "error": "Python 3.11+ is required", "hint": "Install Python 3.11+ or set WPV_PYTHON=/path/to/python3.11"}'
    exit 2
  fi
  echo "[wpv] first run: creating environment in $VENV (about a minute)..." >&2
  if "$PY" -m venv "$VENV" >&2 && "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check \
       --retries 1 --timeout 20 -r "$REQ" >&2; then
    cp "$REQ" "$VENV/.requirements.installed"
  elif has_deps "$PY"; then
    echo "[wpv] could not install pinned packages (no access to PyPI?); using the preinstalled ones" >&2
    mkdir -p "$VENV" && touch "$VENV/.system-fallback"
    RUN_PY="$PY"
  else
    echo '{"status": "error", "error": "Could not install numpy, matplotlib and reportlab", "hint": "Allow network access to pypi.org and files.pythonhosted.org, or install these packages for python3, then retry."}'
    exit 4
  fi
fi

export MPLBACKEND=Agg
export MPLCONFIGDIR="${MPLCONFIGDIR:-$VENV/.mplconfig}"
export PYTHONPATH="$SKILL_DIR/scripts${PYTHONPATH:+:$PYTHONPATH}"
exec "$RUN_PY" -m wiki_interest "$@"
